# Copy this file to .env and fill in the values before starting the app:
#   cp .env.example .env

PORT=3001
HOST=127.0.0.1            # keep 127.0.0.1 if you'll use a reverse proxy

# Generate with:  openssl rand -hex 32
SECRET=CHANGE_ME_to_a_long_random_hex_string

# Your public URL (no trailing slash) — used to build share links
PUBLIC_URL=https://drive.example.com

# Optional: pre-fill the api_id:api_hash presets on the login screen
API_PRESETS=

# Required: Postgres connection string. All accounts, folders, shares, API
# keys and sessions live here — nothing is re-fetched from Telegram
# automatically, so this is the single source of truth for your data.
DATABASE_URL=postgres://user:password@host:5432/tgdrive
# Set to true if your provider requires SSL with a self-signed cert (most
# managed Postgres hosts — Railway, Render, Supabase, Neon, RDS — do).
DATABASE_SSL=true

# Optional: point uploads/thumbnails/branding assets at a persistent
# volume/path. Defaults to ./data next to the app.
DATA_DIR=

# Optional: maximum accepted upload size in bytes. Rejected early via the
# client's declared size, and re-checked against the actual bytes received
# so a spoofed/missing header can't bypass the limit. Default: 2147483648 (2 GiB).
MAX_UPLOAD_BYTES=2147483648

# Optional: files larger than this are transparently split into multiple
# Telegram messages and reassembled on download. Default: 536870912 (512 MiB).
SPLIT_PART_BYTES=536870912

# Optional: where in-flight upload temp files/parts are written while an
# upload is being received and sent to Telegram. Defaults to DATA_DIR/uploads
# (a persistent path, not /tmp) so container tmpfs limits and restarts don't
# silently lose or corrupt uploads in progress.
UPLOAD_TMP_DIR=/app/data/uploads-tmp

# Optional: how long (in hours) an abandoned upload temp directory may sit
# before the startup sweep removes it. Directories still being actively
# written to (recent mtime) are never touched. Default: 24.
UPLOAD_TMP_MAX_AGE_HOURS=24

# Optional: retry tuning for transient Telegram/network failures during upload
# (see src/tg/retry.js). Permanent errors (bad credentials, invalid channel,
# permissions, invalid file data, etc.) are never retried regardless of these.
# Maximum attempts (including the first) before giving up. Default: 5.
TELEGRAM_UPLOAD_MAX_ATTEMPTS=5
# Initial backoff delay in ms, doubled each attempt (with random jitter). Default: 1000.
TELEGRAM_UPLOAD_RETRY_BASE_MS=1000
# Backoff delay is capped at this many ms, however many attempts remain. Default: 30000.
TELEGRAM_UPLOAD_RETRY_MAX_MS=30000
# If Telegram's FLOOD_WAIT response asks for longer than this many seconds, the
# upload fails immediately with a clear error instead of sleeping indefinitely. Default: 300.
TELEGRAM_UPLOAD_MAX_FLOOD_WAIT_SECONDS=300

# Optional: how many days finished (completed/failed/cancelled) upload job
# records are kept before the startup sweep deletes them. Default: 30.
UPLOAD_JOB_RETENTION_DAYS=30
